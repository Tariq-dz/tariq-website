---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { NAV } from '../config';

interface Props { waitlistHref: string }
const { waitlistHref } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Tariq home">
      <Image src={mark} alt="" width={72} height={Math.round(72 * mark.height / mark.width)} class="brand__mark" loading="eager" />
      <span class="brand__word wordmark" aria-hidden="true" translate="no">Tariq</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul role="list" id="site-nav" class="site-nav__list" data-nav>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary btn--sm site-header__cta" href={waitlistHref}>Join the waitlist</a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <span class="sr-only">Menu</span>
      <span class="menu-btn__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: rgb(38 40 44 / 0.94);
    color: var(--c-cream);
    --fg: var(--c-cream);
    --focus: var(--c-gold);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header { background: rgb(38 40 44 / 0.86); backdrop-filter: blur(14px) saturate(140%); }
  }
  .site-header__inner { height: 100%; display: flex; align-items: center; gap: var(--s-5); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--c-cream); margin-right: auto; }
  .brand__mark { width: 36px; height: auto; }
  .brand__word { font-size: 0.9375rem; letter-spacing: 0.3em; margin-right: -0.3em; }
  .site-nav__list { display: flex; gap: var(--s-1); list-style: none; margin: 0; padding: 0; }
  .site-nav__list a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3);
    color: color-mix(in srgb, var(--c-cream) 88%, transparent); text-decoration: none; font-size: 0.9375rem; font-weight: 520; border-radius: var(--r-pill);
    transition: color var(--dur-1) var(--ease-out);
  }
  .site-nav__list a:hover, .site-nav__list a[aria-current='page'] { color: var(--c-cream); }
  .site-nav__list a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--c-gold); border-radius: 0; }
  .menu-btn { display: none; }

  @media (max-width: 859px) {
    .site-header__inner { gap: var(--s-3); }
    .menu-btn {
      display: inline-grid; place-items: center; width: 44px; height: 44px; margin-right: -10px;
      background: none; border: 0; color: var(--c-cream); cursor: pointer; border-radius: var(--r-sm);
    }
    .menu-btn__bars, .menu-btn__bars::before { display: block; width: 22px; height: 2px; background: currentColor; position: relative; transition: transform var(--dur-2) var(--ease-out); }
    .menu-btn__bars { box-shadow: none; transform: translateY(-3.5px); }
    .menu-btn__bars::before { content: ''; position: absolute; top: 7px; left: 0; }
    .menu-btn[aria-expanded='true'] .menu-btn__bars { transform: translateY(0) rotate(45deg); }
    .menu-btn[aria-expanded='true'] .menu-btn__bars::before { transform: translateY(-7px) rotate(-90deg); }

    .site-nav { position: absolute; inset: var(--header-h) 0 auto 0; }
    .site-nav__list {
      display: none; flex-direction: column; gap: 0; padding: var(--s-3) var(--gutter) var(--s-5);
      background: var(--c-graphite); border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .site-nav__list.is-open { display: flex; }
    .site-nav__list a { font-size: 1.25rem; min-height: 56px; padding: 0; border-radius: 0; color: var(--c-cream); border-bottom: 1px solid rgb(255 255 255 / 0.08); }
    .site-nav__list a[aria-current='page'] { box-shadow: none; color: var(--c-gold); }
  }
  @media (max-width: 379px) {
    .brand__word { display: none; }
  }
</style>
