---
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import monaLatin from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Where the header's "Join the waitlist" button points on this page. */
  waitlistHref?: string;
  /** Structure for later FR/AR pages: pass lang="ar" dir="rtl". */
  lang?: string;
  dir?: 'ltr' | 'rtl';
}

const { title, description, image = '/og.png', noindex = false, waitlistHref = '/#waitlist', lang = 'en', dir = 'ltr' } = Astro.props;
const pageTitle = title === SITE.name ? `${SITE.name}: public transit, navigable and accountable` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#26282c" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.company} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader waitlistHref={waitlistHref} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
