---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalReveal from '../components/TerminalReveal.astro';
import ScreenFlow from '../components/ScreenFlow.astro';
import FilmLightbox from '../components/FilmLightbox.astro';
import formsPair from '../assets/terminal/forms-pair.png';
import handheldOk from '../assets/terminal/handheld-ok.png';
import { SMALL_PRINT } from '../config';

const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const details = [
  { group: 'On its face', items: [
    { name: '7″ display', note: 'Non-touch. Destinations and the fare are shown before the tap.' },
    // U+00A0 between the standard's name and number so the pair never splits across lines in the narrow column
    { name: 'Contactless NFC', note: 'A card or a phone, at the gold ring. Open NFC standards (ISO/IEC 14443).' },
    { name: 'Thermal printer', note: 'A ticket on every tap.' },
  ] },
  { group: 'Inside', items: [
    { name: 'Cellular and GNSS', note: 'Mobile network and satellite positioning, built in.' },
    { name: 'Sealed electronics bay', note: 'Opened only by a technician.' },
    { name: 'Offline queue', note: 'Designed to hold every tap when the network drops, and send them when it returns.' },
  ] },
  { group: 'On the vehicle', items: [
    { name: 'One sealed connector', note: 'One connection. Nothing exposed. Recessed into the bottom edge.' },
    { name: 'Pole mount', note: 'Mounts to the pole. Nothing else on the back.' },
    { name: 'Paper reload without tools', note: 'The roll sits outside the sealed bay.' },
  ] },
];

// The handheld: each line traces to the hardware repo (tariq-hardware docs/2026-10-16-handheld-finish-and-films.md and the
// handheld film's approved script); nothing about power or battery, and nothing that reads as one vehicle type.
const handheld = [
  { name: 'The same 7″ display', note: 'The same screens as the mounted terminal, in the same order.' },
  { name: 'One tap, on the head', note: 'The gold ring sits in the paper door. A card or a phone.' },
  { name: 'A tear, not a wait', note: 'A ticket on every tap, torn off a steel bar.' },
  { name: 'Soft in the hand', note: 'A fluted grip down each side, and a palm pad on the back.' },
];

// The films, the two-forms film first. Native size only (854×480 drafts); each opens its own lightbox.
const films = [
  { id: 'film-forms', file: 'tariq-forms-film', title: 'One terminal. Two forms.', length: '0:40', feature: true },
  { id: 'film', file: 'tariq-terminal-film', title: 'The mounted terminal', length: '1:24' },
  { id: 'film-handheld', file: 'tariq-handheld-film', title: 'The handheld', length: '0:50' },
];
const play = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5.5v9l7-4.5z" fill="currentColor" /></svg>';
---

<BaseLayout
  title="The terminal"
  description="Meet the Tariq terminal, mounted on board or carried in hand: an NFC terminal designed in Algeria. Choose a destination, see the fare, tap once, and a ticket prints. Every tap, on the record."
>
  <TerminalReveal />

  <ScreenFlow />

  <!-- The details -->
  <section class="details section" aria-labelledby="details-title">
    <div class="container">
      <h2 class="h2 details__title" id="details-title" data-reveal>Sealed. Secure. Built to be trusted.</h2>
      <p class="lead details__lead" data-reveal>The electronics sit in a sealed bay that only a technician opens.</p>
      <div class="details__groups" data-reveal>
        {details.map((g) => (
          <div class="details__group">
            <h3 class="details__group-title">{g.group}</h3>
            <ul class="details__names" role="list">
              {g.items.map((it) => (
                <li><span class="details__name">{it.name}</span><span class="details__note">{it.note}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Two forms: the mounted terminal and the handheld, one composed frame (the two-forms film's hero pair) -->
  <section class="forms section surface-slate" aria-labelledby="forms-title" data-terminal-media>
    <div class="container">
      <div class="forms__head">
        <h2 class="h2" id="forms-title" data-reveal>One terminal. Two forms.</h2>
        <p class="lead" data-reveal>Mounted on board, or carried down the aisle. Each operator chooses one, and the record is the same either way.</p>
      </div>
      <div class="forms__stage">
        <Image src={formsPair} alt="The two forms of the Tariq terminal: the mounted terminal, with its display, printer and gold tap ring, and the handheld standing in front of it to the right. Both show the Tariq idle screen." widths={[640, 960, 1280, formsPair.width]} sizes="(min-width: 1240px) 1100px, 92vw" class="forms__img render-fade-rect" style={`max-width:${formsPair.width}px`} loading="lazy" data-reveal />
        <ul class="forms__list" role="list">
          <li data-reveal><h3 class="h3">Mounted</h3><p>Where no one collects fares. It boards passengers on its own.</p></li>
          <li data-reveal><h3 class="h3">In hand</h3><p>Where someone does. A second person, and a second pair of eyes.</p></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- The handheld -->
  <section class="hand section section--flush-top surface-slate" aria-labelledby="hand-title" data-terminal-media>
    <div class="container hand__grid">
      <div class="hand__art" data-reveal>
        <Image src={handheldOk} alt="The Tariq handheld just after a tap: its screen green with “Have a good trip” and 40 DA, and the printed ticket rising from its head" widths={[360, 540, handheldOk.width]} sizes="(min-width: 900px) 34vw, 80vw" class="hand__img render-fade-rect" style={`max-width:${handheldOk.width}px`} loading="lazy" />
      </div>
      <div class="hand__copy">
        <h2 class="h2" id="hand-title" data-reveal>Made to be held.</h2>
        <p class="lead" data-reveal>The handheld is for crews who collect fares on board: the same screens, the same tap and the same signed record, carried down the aisle.</p>
        <ul class="hand__list" role="list" data-reveal>
          {handheld.map((it) => (
            <li><span class="hand__name">{it.name}</span><span class="hand__note">{it.note}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Films -->
  <section class="films section section--flush-top surface-slate" aria-labelledby="films-title" data-terminal-media>
    <div class="container">
      <div class="films__head">
        <h2 class="h2" id="films-title" data-reveal>Watch the films.</h2>
        <p class="lead" data-reveal>Both forms together, then each one on its own.</p>
      </div>
      <ul class="films__grid" role="list">
        {films.map((f) => (
          <li class:list={['films__item', { 'films__item--feature': f.feature }]} data-reveal>
            <button class="films__poster" type="button" data-lightbox-open={f.id}>
              <span class="films__frame">
                <img src={`${import.meta.env.BASE_URL}media/film/${f.file}.webp`} alt="" width="854" height="480" loading="lazy" decoding="async" class="films__img" />
                <span class="films__play"><Fragment set:html={play} /><span class="sr-only">Play the film: </span></span>
              </span>
              <span class="films__caption"><span class="films__title">{f.title}</span><span class="films__len num"><span class="sr-only">, </span>{f.length}</span></span>
            </button>
          </li>
        ))}
      </ul>
      <p class="small-print films__fine">{SMALL_PRINT}</p>
    </div>
    {films.map((f) => <FilmLightbox id={f.id} title={f.title} film={f.file} />)}
  </section>

  <!-- Service + close -->
  <section class="close section surface-slate" aria-labelledby="close-title">
    <div class="container close__inner">
      <h2 class="h2" id="close-title" data-reveal>Installed and maintained by Tariq.</h2>
      <p class="lead" data-reveal>Delivered as a service: Tariq installs the mounted terminal on board, or supplies the handheld to your crew, and maintains it.</p>
      <div class="close__cta" data-reveal>
        <a class="btn btn--primary" href={`${import.meta.env.BASE_URL}operators#contact`}>Talk to us</a>
        <a class="link-arrow" href={`${import.meta.env.BASE_URL}operators#see-title`}>See the signed record <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split { padding-block: var(--section-pad); }
  .split--paper { background: var(--c-paper); }
  .split__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); align-items: center; }
  .split__grid--flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .split__copy { display: grid; gap: var(--s-5); }
  .split__copy .h2 { max-width: 14ch; }
  .split__img { width: 100%; max-width: 560px; height: auto; margin-inline: auto; }
  .split__img--detail { max-width: 460px; }
  .split__art--panel { border-radius: var(--r-panel); overflow: hidden; }
  @media (max-width: 899px) {
    .split__grid, .split__grid--flip { grid-template-columns: 1fr; gap: var(--s-6); }
    .split__grid--flip .split__art { order: 2; }
  }

  .details { background: var(--c-paper); padding-top: 0; }
  .details__title { max-width: 16ch; margin-bottom: var(--s-4); }
  .details__lead { max-width: 48ch; margin-bottom: var(--s-8); }
  .details__groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-7); }
  .details__names { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .details__name { display: block; font-size: var(--fs-h3); font-weight: 620; font-stretch: 108%; letter-spacing: -0.01em; line-height: 1.15; }
  .details__note { display: block; margin-top: 4px; font-size: var(--fs-small); color: var(--fg-muted); }
  .details__group { border-top: 2px solid var(--c-graphite); padding-top: var(--s-4); }
  .details__group-title { font-size: var(--fs-small); font-weight: 600; color: var(--c-gold-deep); margin-bottom: var(--s-5); }
  .details__list { margin: 0; display: grid; gap: var(--s-5); }
  .details__item dt { font-size: var(--fs-h3); font-weight: 620; font-stretch: 108%; letter-spacing: -0.01em; line-height: 1.15; }
  .details__item dd { margin: var(--s-1) 0 0; color: var(--fg-muted); }
  @media (max-width: 899px) { .details__groups { grid-template-columns: 1fr; gap: var(--s-6); } }
  /* A2: on phones the short items sit two per row, so the list reads as a set instead of one long column */
  @media (max-width: 899px) {
    .details__names { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-4); }
    .details__name { font-size: 1.125rem; }
  }

  /* two forms: one composed frame, each form named under itself (columns follow the crop: the mounted terminal
     fills the left of the frame, the handheld the right) */
  .forms__head { display: grid; gap: var(--s-4); justify-items: center; text-align: center; margin-bottom: var(--s-6); }
  .forms__head .lead { max-width: 44ch; text-wrap: balance; }
  .forms__stage { max-width: 1100px; margin-inline: auto; }
  .forms__img { width: 100%; height: auto; margin-inline: auto; }
  /* measured on forms-pair.png: the mounted terminal spans 19–56.5% of the frame's width, the handheld 56.5–81% */
  .forms__list { display: grid; grid-template-columns: 19fr 37.5fr 24.5fr 19fr; column-gap: var(--s-5); margin-top: var(--s-5); }
  .forms__list li:first-child { grid-column: 2; }
  .forms__list li:last-child { grid-column: 3; }
  .forms__list li { border-top: 2px solid var(--c-gold); padding-top: var(--s-4); display: grid; gap: var(--s-2); align-content: start; }
  .forms__list p { color: var(--fg-muted); max-width: 34ch; }
  @media (max-width: 899px) {
    .forms__head { justify-items: start; text-align: left; }
    .forms__list { grid-template-columns: 1fr; gap: var(--s-5); }
    .forms__list li:first-child, .forms__list li:last-child { grid-column: 1; }
  }

  /* the handheld: the render beside its four details */
  .hand__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); align-items: center; }
  .hand__img { width: 100%; height: auto; margin-inline: auto; }
  .hand__copy { display: grid; gap: var(--s-5); }
  .hand__copy .h2 { max-width: 14ch; }
  .hand__copy .lead { max-width: 40ch; }
  .hand__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--s-6); margin-top: var(--s-3); }
  .hand__list li { border-top: 1px solid var(--line); padding-top: var(--s-4); }
  .hand__name { display: block; font-size: var(--fs-h3); font-weight: 620; font-stretch: 108%; letter-spacing: -0.01em; line-height: 1.15; }
  .hand__note { display: block; margin-top: 4px; font-size: var(--fs-small); color: var(--fg-muted); }
  @media (max-width: 899px) {
    .hand__grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .hand__art { max-width: 360px; margin-inline: auto; width: 100%; }
    .hand__list { gap: var(--s-5) var(--s-4); }
    .hand__name { font-size: 1.125rem; }
  }

  /* films: the two-forms film large, the two single-form films side by side under it, all at most native width */
  .films__head { display: grid; gap: var(--s-4); justify-items: center; text-align: center; margin-bottom: var(--s-7); }
  .films__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); max-width: 854px; margin-inline: auto; }
  .films__item--feature { grid-column: 1 / -1; }
  .films__poster { display: grid; gap: var(--s-3); width: 100%; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; border-radius: var(--r-panel); }
  .films__frame { position: relative; display: block; border-radius: var(--r-panel); overflow: hidden; }
  .films__img { width: 100%; height: auto; transition: transform var(--dur-3) var(--ease-out); }
  .films__poster:hover .films__img { transform: scale(1.015); }
  .films__play {
    position: absolute; left: var(--s-4); bottom: var(--s-4); display: grid; place-items: center; width: 48px; height: 48px;
    border-radius: var(--r-pill); background: var(--c-gold); color: var(--c-graphite);
    transition: transform var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .films__item--feature .films__play { width: 56px; height: 56px; left: var(--s-5); bottom: var(--s-5); }
  .films__play svg { width: 22px; height: 22px; }
  .films__poster:hover .films__play { background: var(--btn-primary-bg-hover); transform: scale(1.06); }
  .films__caption { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); padding-inline: var(--s-1); }
  .films__title { font-weight: 600; font-stretch: 106%; }
  .films__item--feature .films__title { font-size: var(--fs-h3); letter-spacing: -0.012em; line-height: 1.15; }
  .films__len { color: var(--fg-muted); font-size: var(--fs-small); }
  .films__poster:focus-visible { outline: 2.5px solid var(--c-gold); outline-offset: 6px; }
  .films__fine { text-align: center; margin: var(--s-6) auto 0; }
  @media (max-width: 899px) {
    .films__head { justify-items: start; text-align: left; }
    .films__grid { grid-template-columns: 1fr; }
    .films__fine { text-align: left; margin-inline: 0; }
  }

  .close { padding-top: 0; }
  .close__inner { display: grid; gap: var(--s-5); }
  .close__inner > * { max-width: 760px; }
  .close__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-top: var(--s-2); }
</style>
