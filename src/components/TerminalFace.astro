---
// The front render of the terminal with its real screens placed on the display glass, and the real
// printed ticket that can rise out of the printer slot. Positions come from scripts/lib/prepare-images.mjs.
import { Image } from 'astro:assets';
import face from '../assets/terminal/face.png';
import idle from '../assets/screens/idle.png';
import dest from '../assets/screens/dest.png';
import pay from '../assets/screens/pay.png';
import tap from '../assets/screens/tap.png';
import ok from '../assets/screens/ok.png';
import ticket40 from '../assets/screens/ticket40.png';
import geo from '../data/terminal-face.json';

const SCREENS = { idle, dest, pay, tap, ok } as const;
type ScreenName = keyof typeof SCREENS;
const ALT: Record<ScreenName, string> = {
  idle: 'Terminal idle screen with the Tariq mark',
  dest: 'Destination list: Bab El Oued 30 DA, Bologhine 40 DA, Staoueli 50 DA and more',
  pay: 'Terminal asks how you would like to pay: with a card or with a phone',
  tap: 'Terminal screen: present your card, Bologhine, 40 DA',
  ok: 'Green confirmation: have a good trip, 40 DA, Bologhine, Line 12',
};

interface Props {
  screens?: ScreenName[];   // stacked in this order; the first is visible
  active?: ScreenName;
  ticket?: boolean;         // include the printed ticket (hidden until .is-printed)
  ticketShown?: boolean;    // render the ticket already out (static layouts)
  sizes?: string;
  eager?: boolean;
  class?: string;
  id?: string;
}
const { screens = ['idle'], active = screens[0], ticket = false, ticketShown = false, sizes = '(max-width: 860px) 90vw, 560px', eager = false, class: cls, id } = Astro.props;
const g = geo.glass;
const s = geo.slot;
const ticketH = s.width * (960 / 1380) * geo.aspect;
---

<div class:list={['tface', cls, { 'is-printed': ticketShown }]} id={id} data-terminal-media style={`--aspect:${geo.aspect}`}>
  <Image src={face} alt="Front of the Tariq terminal: display, printer and gold tap ring" widths={[480, 767]} sizes={sizes} class="tface__body" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  {ticket && (
    <div class="tface__ticket" style={`left:${s.left}%;width:${s.width}%;bottom:${100 - s.top}%;height:${ticketH}%`} aria-hidden={ticketShown ? undefined : 'true'}>
      <Image src={ticket40} alt="Printed ticket: Place des Martyrs to Bologhine, Line 12, bus, 40 DA, with a QR code" widths={[240, 420]} sizes="200px" class="tface__ticket-img" loading="lazy" />
    </div>
  )}
  <div class="tface__glass" style={`left:${g.left}%;top:${g.top}%;width:${g.width}%;height:${g.height}%`}>
    {screens.map((name) => (
      <Image src={SCREENS[name]} alt={ALT[name]} widths={[330, 630]} sizes="(max-width: 860px) 40vw, 260px" class:list={['tface__screen', { 'is-active': name === active }]} data-screen={name} loading={eager && name === active ? 'eager' : 'lazy'} />
    ))}
  </div>
</div>

<style>
  :where(.tface) { position: relative; width: 100%; }
  .tface { aspect-ratio: var(--aspect); }
  .tface__body { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tface__glass { position: absolute; overflow: hidden; background: #141414; border-radius: 0.6%; }
  .tface__screen { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity var(--dur-2) var(--ease-out); }
  .tface__screen.is-active { opacity: 1; }
  .tface__ticket { position: absolute; overflow: hidden; pointer-events: none; }
  .tface__ticket-img {
    position: absolute; left: 0; bottom: 0; width: 100%; height: 100%; object-fit: cover;
    transform: translateY(101%);
    transition: transform 1.1s var(--ease-out);
    box-shadow: 0 -2px 6px rgb(0 0 0 / 0.25);
  }
  .tface.is-printed .tface__ticket-img { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .tface__screen, .tface__ticket-img { transition: none; }
  }
</style>
