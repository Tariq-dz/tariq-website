---
// A phone with either a real app clip (muted, at most 5 s, played once each time it scrolls into view; poster only with
// reduced motion) or a real still. Screen ratio 434:888 = the cropped demo video.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  clip?: string;              // name in public/media/clips
  still?: ImageMetadata;
  label: string;              // what the screen shows (alt / aria-label)
  eager?: boolean;
  sizes?: string;
  class?: string;
  /** false when a sequence script controls playback itself */
  autoplay?: boolean;
}
const { clip, still, label, eager = false, sizes = '(max-width: 860px) 70vw, 340px', class: cls, autoplay = true } = Astro.props;
---

<figure class:list={['phone', cls]}>
  <div class="phone__screen">
    {clip ? (
      <img class="phone__media phone__poster" src={`/media/clips/${clip}.webp`} alt="" width="434" height="888" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
      <video
        class="phone__media phone__video"
        muted
        playsinline
        preload="none"
        width="434"
        height="888"
        aria-label={label}
        data-autoplay={autoplay ? '' : undefined}
      >
        <source src={`/media/clips/${clip}.webm`} type="video/webm" />
        <source src={`/media/clips/${clip}.mp4`} type="video/mp4" />
      </video>
    ) : still ? (
      <Image src={still} alt={label} widths={[320, 480, 720]} sizes={sizes} class="phone__media" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
    ) : null}
  </div>
  <slot />
</figure>

<style>
  :where(.phone) { position: relative; width: 100%; }
  .phone {
    /* a thin graphite-metal bezel in the terminal's own finish, so the phone and the terminal read as one product family */
    padding: 2.4%;
    border-radius: 12% / 5.9%;
    background: linear-gradient(155deg, #55585e 0%, #2c2e32 22%, #1a1b1e 60%, #3a3d42 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.16),
      inset 0 0 0 3px rgb(0 0 0 / 0.35),
      0 1px 2px rgb(20 18 14 / 0.25),
      0 24px 60px -18px rgb(20 18 14 / 0.45);
  }
  .phone__screen {
    position: relative;
    aspect-ratio: 434 / 888;
    border-radius: 10.5% / 5.1%;
    overflow: hidden;
    background: #2e2e2e;
    isolation: isolate;
  }
  .phone__media { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .phone__poster { position: absolute; inset: 0; }
  /* a video with no data yet paints nothing, so the poster image shows through; once playing, its frames cover it */
  .phone__video { position: relative; }
</style>
